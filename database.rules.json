{
  "rules": {
    "rooms": {
      "$farm": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'x', 'z']) || !newData.exists()",
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "e": { ".validate": "newData.isString() && newData.val().length <= 30" }
        }
      }
    }
  }
}
