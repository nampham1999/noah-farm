rules_version = '2';

// Luật bảo mật cho Noah Farm (dán vào Firebase Console → Firestore Database → Rules).
// Nhóm nhỏ người quen: mỗi người chỉ ghi được dữ liệu của mình; bạn bè đọc được nông trại
// của nhau; quà và tưới giúp mỗi loại mỗi ngày một lần (mã thư gồm người gửi và ngày).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Hồ sơ: ai đã đăng nhập cũng đọc được (để xem danh sách bạn); chỉ chủ được ghi.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;

      // Danh sách bạn: ghi hai chiều khi kết bạn, nên chủ hoặc chính người bạn đó được ghi.
      match /friends/{fid} {
        allow read: if isMe(uid);
        allow create, update, delete: if isMe(uid) || isMe(fid);
      }

      // Hộp thư: chỉ bạn bè được gửi, mỗi mã thư chỉ tạo một lần (không ghi đè được).
      match /inbox/{id} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.read == false
          && id.matches(request.auth.uid + '_((gift|help|note)_[0-9]{8}|give_[0-9]+)')
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
      }
    }

    // Lời nhờ giúp: chủ tạo/xoá; người khác chỉ được cộng thêm số "đã có" (không vượt số cần).
    match /requests/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isMe(uid);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['have'])
        && request.resource.data.have > resource.data.have
        && request.resource.data.have <= resource.data.qty;
    }

    // Đổi đồ: người gửi tạo (status open); người nhận chỉ đổi open → accepted/declined;
    // người gửi chỉ đổi open → cancelled hoặc accepted/declined → done. Không sửa được nội dung.
    match /trades/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.give.qty > 0 && request.resource.data.want.qty > 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.to == request.auth.uid && resource.data.status == 'open'
              && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.from == request.auth.uid && resource.data.status == 'open'
              && request.resource.data.status == 'cancelled')
          || (resource.data.from == request.auth.uid && resource.data.status in ['accepted', 'declined']
              && request.resource.data.status == 'done'));
    }

    // Mã bạn bè → uid: đặt chỗ một lần, không đổi chủ.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && code.matches('[a-z0-9]{4,12}');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Kênh Làng: ai đã đăng nhập cũng đọc và nói được; tin có tên mình, tối đa 200 ký tự,
    // giờ do máy chủ đặt; chỉ xoá được tin của mình.
    match /world/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.kind in ['msg', 'event']
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Chat riêng: mã cuộc trò chuyện là hai uid nối bằng "_"; chỉ hai người đó đọc ghi được.
    match /dms/{pair} {
      function inPair() {
        return signedIn() && request.auth.uid in pair.split('_');
      }
      allow read, write: if inPair();
      match /messages/{id} {
        allow read: if inPair();
        allow create: if inPair()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.at == request.time;
        allow delete: if inPair() && resource.data.uid == request.auth.uid;
      }
    }

    // Bản lưu: chủ ghi; người đã đăng nhập đọc được (để ghé thăm nông trại bạn).
    match /saves/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
  }
}
